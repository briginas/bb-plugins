{
  "name": "bb-plugin-oldtale-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Oldtale colors for the BB interface, terminal, and code, with dark and light modes.",
  "license": "MIT",
  "author": "Ivan Briginas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briginas/bb-plugin-oldtale-theme.git"
  },
  "homepage": "https://github.com/briginas/bb-plugin-oldtale-theme#readme",
  "bugs": { "url": "https://github.com/briginas/bb-plugin-oldtale-theme/issues" },
  "keywords": ["bb", "bb-plugin", "bb-theme", "theme", "oldtale"],
  "files": [
    "assets/icon.svg", "dist", "src", "themes", "PLUGIN_OVERVIEW.md",
    "THIRD_PARTY_NOTICES.md", "UPSTREAM.md", "upstream/oldtale-dark.json"
  ],
  "engines": { "bb": ">=0.46.0", "bbPluginSdk": "^0.6.37" },
  "bb": {
    "name": "Oldtale Theme",
    "description": "Oldtale colors for the BB interface, terminal, and code, with dark and light modes.",
    "branding": { "icon": "./assets/icon.svg" },
    "server": "./src/server.ts",
    "skills": [],
    "themes": [
      {
        "id": "oldtale",
        "name": "Oldtale",
        "description": "Graphite surfaces and the Oldtale syntax palette, with a companion light mode.",
        "css": "./themes/oldtale.css",
        "codeTheme": { "dark": "./themes/pierre-dark.json", "light": "github-light" }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "verify": "node scripts/verify.mjs",
    "check": "npm run typecheck && npm run build && npm run verify"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@types/node": "^22.0.0",
    "bb-app": "0.46.0",
    "typescript": "^5.7.0"
  }
}
